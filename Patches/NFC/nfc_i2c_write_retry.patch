diff --git a/drivers/nfc/nq-nci.c b/drivers/nfc/nq-nci.c
index 0000000..0000000 100644
--- a/drivers/nfc/nq-nci.c
+++ b/drivers/nfc/nq-nci.c
@@ -402,6 +402,7 @@ static ssize_t nfc_write(struct file *filp, const char __user *buf,
 	struct nqx_dev *nqx_dev = filp->private_data;
 	char *tmp = NULL;
 	int ret = 0;
+	int retry_cnt;
 
 	if (!nqx_dev) {
 		ret = -ENODEV;
@@ -427,11 +428,24 @@ static ssize_t nfc_write(struct file *filp, const char __user *buf,
 	print_send_buffer(nqx_dev, tmp, count);
 #endif
 
-	ret = i2c_master_send(nqx_dev->client, tmp, count);
-	if (ret != count) {
-		dev_err(&nqx_dev->client->dev,
-		"%s: failed to write %d\n", __func__, ret);
-		ret = -EIO;
+	for (retry_cnt = 0; retry_cnt < MAX_RETRY_COUNT; retry_cnt++) {
+		ret = i2c_master_send(nqx_dev->client, tmp, count);
+		if (ret == count)
+			break;
+
+		dev_err(&nqx_dev->client->dev,
+			"%s: I2C write attempt %d/%d failed (%d)\n",
+			__func__, retry_cnt + 1, MAX_RETRY_COUNT, ret);
+		if (retry_cnt + 1 < MAX_RETRY_COUNT)
+			usleep_range(10000, 11000);
+	}
+
+	if (ret != count) {
+		if (ret >= 0)
+			ret = -EIO;
+		dev_err(&nqx_dev->client->dev,
+			"%s: I2C write failed after %d attempts\n",
+			__func__, MAX_RETRY_COUNT);
 		goto out_free;
 	}
 #ifdef NFC_KERNEL_BU
